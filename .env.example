# Dynamics 365 organisation URL (no trailing slash)
D365_URL=https://bsh-paramount-dev-cc.crm4.dynamics.com

# CC Agent test user – must have the "BSH CC Agent - validating" role assigned
CC_AGENT_USERNAME=ccagent@yourorg.onmicrosoft.com
CC_AGENT_PASSWORD=YourPassword123!

# Optional: Base32 TOTP secret for the CC Agent account.
# Found in the authenticator app QR code (otpauth://totp/...?secret=BASE32HERE).
# If omitted, the browser will pause and wait for you to approve MFA manually.
CC_AGENT_TOTP_SECRET=

# Admin user for the admin-recording spec and post-test record cleanup.
# (CC Agent role cannot delete Accounts, Contacts, or Cases)
D365_ADMIN_USERNAME=admin@yourorg.onmicrosoft.com
D365_ADMIN_PASSWORD=AdminPassword123!

# Optional: Base32 TOTP secret for the admin account (same format as above).
D365_ADMIN_TOTP_SECRET=
